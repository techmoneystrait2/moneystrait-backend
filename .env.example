# Copy to .env for local work. Keep values blank here; never commit real ones.
# Production values live in the host's secret store.

NODE_ENV=
PORT=

# Exact site address, for example the local Next.js URL. Used for the CSRF origin check.
FRONTEND_ORIGIN=
# Proxies in front of this server. The Next.js rewrite counts as one.
TRUST_PROXY_HOPS=

# Database
MONGODB_URI=

# Sessions and tokens. At least 32 characters.
SESSION_SECRET=

# Google sign-in. The same client ID as the frontend. No client secret is needed.
GOOGLE_CLIENT_ID=

# Sumsub
SUMSUB_BASE_URL=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_COMPANY_LEVEL=
SUMSUB_PERSON_LEVEL=

# Bot protection
TURNSTILE_SECRET_KEY=

# Vendors
BOOKING_API_KEY=
CRM_API_KEY=
EMAIL_API_KEY=
CMS_API_TOKEN=

# Staff sign-in
STAFF_OAUTH_CLIENT_ID=
STAFF_OAUTH_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=
